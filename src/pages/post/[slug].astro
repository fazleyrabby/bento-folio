---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(p => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const all = (await getCollection('posts')).filter(p => !p.data.draft);
const related = all
  .filter(p => p.id !== post.id)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 3);

const dt = new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<BaseLayout title={`${post.data.title} — Fazley Rabby`} description={post.data.description} image={post.data.cover}>
  <div id="reading-progress" class="fixed top-0 left-0 h-0.5 bg-[color:var(--color-accent)] z-50" style="width:0%"></div>

  <article class="max-w-[1480px] mx-auto px-4 md:px-6 pt-10 pb-28">
    <a href="/posts" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg mb-6">
      <Icon name="arrow" size={14} class="rotate-180" /> Back to posts
    </a>

    {post.data.cover && (
      <div class="card overflow-hidden mb-8 aspect-[21/9]">
        <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <header class="mb-8 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2 text-xs text-dim uppercase tracking-wider">
        {post.data.category && <span class="pill">{post.data.category}</span>}
        <span>{dt}</span>
        {post.data.readingTime && <><span class="opacity-40">·</span><span class="inline-flex items-center gap-1"><Icon name="clock" size={11} />{post.data.readingTime}</span></>}
      </div>
      <h1 class="mt-4 font-display text-3xl md:text-5xl font-medium tracking-tight leading-tight">{post.data.title}</h1>
      {post.data.description && <p class="mt-3 text-lg text-muted">{post.data.description}</p>}
    </header>

    <div class="grid lg:grid-cols-[1fr_240px] gap-10">
      <div class="prose-content max-w-3xl">
        <Content />

        <div class="mt-12 pt-6 border-t border-soft flex items-center gap-3">
          <span class="text-sm text-dim">Share:</span>
          <a class="pill !cursor-pointer" href={`https://x.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${Astro.url.href}`}>X</a>
          <a class="pill !cursor-pointer" href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url.href}`}>LinkedIn</a>
          <button id="copy-url" class="pill !cursor-pointer">Copy link</button>
        </div>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-6">
          <div class="card p-5">
            <div class="text-xs uppercase tracking-wider text-dim mb-3">On this page</div>
            <ul class="space-y-1.5 text-sm">
              {headings.filter(h => h.depth <= 3).map(h => (
                <li><a href={`#${h.slug}`} class:list={['block text-muted hover:accent transition-colors', h.depth === 3 && 'pl-3']}>{h.text}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-16">
        <h2 class="font-display text-xl mb-4">Related posts</h2>
        <div class="bento">
          {related.map(p => (
            <BlogCard post={{ slug: p.id, title: p.data.title, description: p.data.description, cover: p.data.cover, date: p.data.date, readingTime: p.data.readingTime, category: p.data.category }} />
          ))}
        </div>
      </section>
    )}
  </article>

  <style is:global>
    .prose-content { color: var(--color-fg); line-height: 1.75; font-size: 1.0625rem; }
    .prose-content h2 { font-family: var(--font-display); font-size: 1.75rem; font-weight: 500; margin-top: 2.5rem; margin-bottom: 1rem; letter-spacing: -0.01em; }
    .prose-content h3 { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; margin-top: 2rem; margin-bottom: 0.5rem; }
    .prose-content p { margin: 1rem 0; color: var(--color-fg-muted); }
    .prose-content a { color: var(--color-accent); text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--color-accent) 35%, transparent); text-underline-offset: 3px; }
    .prose-content ul, .prose-content ol { margin: 1rem 0; padding-left: 1.25rem; color: var(--color-fg-muted); }
    .prose-content li { margin: 0.35rem 0; }
    .prose-content code { font-family: var(--font-mono); font-size: 0.9em; background: var(--color-surface-2); padding: 0.15em 0.4em; border-radius: 6px; border: 1px solid var(--color-border-soft); }
    .prose-content pre { background: var(--color-bg-elev); border: 1px solid var(--color-border-soft); border-radius: 14px; padding: 1rem 1.25rem; overflow-x: auto; margin: 1.25rem 0; }
    .prose-content pre code { background: none; border: none; padding: 0; }
    .prose-content blockquote { border-left: 2px solid var(--color-accent); padding-left: 1rem; color: var(--color-fg-muted); font-style: italic; margin: 1.25rem 0; }
    .prose-content strong { color: var(--color-fg); }
  </style>

  <script>
    const bar = document.getElementById('reading-progress');
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const p = max > 0 ? (h.scrollTop / max) * 100 : 0;
      if (bar) bar.style.width = p + '%';
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    document.getElementById('copy-url')?.addEventListener('click', () => {
      navigator.clipboard.writeText(location.href);
    });
  </script>
</BaseLayout>
