---
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoCard from '../components/BentoCard.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
const sections = [
  { key: 'hardware', label: 'Hardware', icon: 'chip', span: 'col-span-12 lg:col-span-7', items: site.uses.hardware },
  { key: 'dev', label: 'Development Setup', icon: 'layers', span: 'col-span-12 lg:col-span-5', items: site.uses.dev },
  { key: 'apps', label: 'Applications', icon: 'grid', span: 'col-span-12 md:col-span-6 lg:col-span-4', items: site.uses.apps },
  { key: 'ai', label: 'AI Tools', icon: 'spark', span: 'col-span-12 md:col-span-6 lg:col-span-4', items: site.uses.ai },
  { key: 'productivity', label: 'Productivity', icon: 'bolt', span: 'col-span-12 lg:col-span-4', items: site.uses.productivity },
];
---
<BaseLayout title="Uses — Fazley Rabby" description="Hardware, software, and tooling I use every day.">
  <div class="px-4 md:px-6 pt-10 pb-28 max-w-[1480px] mx-auto">
    <PageHeader eyebrow="My setup" title="What I use, every day." description="The hardware, dev tools, and apps that survived the cull. Updated quarterly." />
    <BentoGrid>
      {sections.map(s => (
        <BentoCard span={s.span}>
          <header class="flex items-center gap-2 mb-3">
            <span class="grid place-items-center w-7 h-7 rounded-lg bg-surface-2 accent"><Icon name={s.icon} size={14} /></span>
            <h2 class="font-display text-base">{s.label}</h2>
          </header>
          <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2.5">
            {s.items.map(i => (
              <li class="flex items-baseline justify-between gap-2 py-1.5 border-b border-soft last:border-b-0">
                <span class="text-sm">{i.name}</span>
                <span class="text-xs text-dim">{i.note}</span>
              </li>
            ))}
          </ul>
        </BentoCard>
      ))}
    </BentoGrid>
  </div>
</BaseLayout>
