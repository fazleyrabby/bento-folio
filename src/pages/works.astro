---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const categories = Array.from(new Set(works.map(w => w.data.category).filter(Boolean))) as string[];
---
<BaseLayout title="Works — BentoFolio" description="Selected projects, libraries, and tools.">
  <div class="px-3 md:px-4 pt-10 pb-24 max-w-[1480px] mx-auto">
    <PageHeader eyebrow="Selected work" title="Things I've built." description="A gallery of products, libraries, and tools." />

    <div class="mb-5 flex flex-wrap items-center gap-2">
      <div class="relative flex-1 min-w-[220px] max-w-md">
        <Icon name="search" size={14} class="absolute left-3 top-1/2 -translate-y-1/2 text-dim" />
        <input id="work-search" type="search" placeholder="Search projects…" class="w-full h-10 pl-9 pr-3 rounded-full bg-surface border border-soft outline-none focus:border-[color:var(--color-accent)] text-sm" />
      </div>
      <div class="flex flex-wrap gap-1.5" id="work-filters">
        <button data-cat="all" class="pill !cursor-pointer is-active">All</button>
        {categories.map(c => <button data-cat={c} class="pill !cursor-pointer">{c}</button>)}
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {works.map(w => (
        <ProjectCard
          project={{
            slug: w.id,
            title: w.data.title,
            description: w.data.description,
            cover: w.data.cover,
            tech: w.data.tech,
            github: w.data.github,
            url: w.data.url,
            category: w.data.category,
          }}
          span=""
        />
      ))}
    </div>
  </div>

  <style>
    #work-filters .is-active { background: color-mix(in oklab, var(--color-accent) 15%, var(--color-surface-2)); color: var(--color-accent); border-color: color-mix(in oklab, var(--color-accent) 40%, var(--color-border-soft)); }
  </style>

  <script>
    const filters = document.getElementById('work-filters');
    const search = document.getElementById('work-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('article.card');
    let activeCat = 'all';
    const apply = () => {
      const q = (search?.value || '').toLowerCase().trim();
      cards.forEach(c => {
        const cat = (c.querySelector('.pill')?.textContent || '').toLowerCase();
        const title = (c.querySelector('h3')?.textContent || '').toLowerCase();
        const text = (c.textContent || '').toLowerCase();
        const catOk = activeCat === 'all' || cat === activeCat.toLowerCase();
        const qOk = !q || title.includes(q) || text.includes(q);
        c.style.display = catOk && qOk ? '' : 'none';
      });
    };
    filters?.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('button');
      if (!t) return;
      filters.querySelectorAll('button').forEach(b => b.classList.remove('is-active'));
      t.classList.add('is-active');
      activeCat = t.dataset.cat || 'all';
      apply();
    });
    search?.addEventListener('input', apply);
  </script>
</BaseLayout>
