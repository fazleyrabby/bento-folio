---
import BentoCard from './BentoCard.astro';
import Icon from './Icon.astro';
interface Props {
  title: string;
  description: string;
  tech: string[];
  cover?: string;
  href?: string;
}
const { title, description, tech, cover, href = '/works' } = Astro.props;
---
<BentoCard span="col-span-12 lg:col-span-7" padded={false}>
  <div class="grid md:grid-cols-5 h-full">
    <div class="md:col-span-3 p-4 md:p-5 flex flex-col justify-between gap-3">
      <div>
        <span class="pill"><Icon name="bolt" size={11} /> Featured</span>
        <h2 class="mt-2 font-display text-xl md:text-2xl font-medium tracking-tight leading-tight">{title}</h2>
        <p class="mt-1.5 text-sm text-muted line-clamp-2">{description}</p>
      </div>
      <div class="space-y-2.5">
        <div class="flex flex-wrap gap-1.5">
          {tech.map(t => <span class="pill">{t}</span>)}
        </div>
        <a href={href} class="inline-flex items-center gap-1.5 text-sm font-medium accent hover:opacity-80">View project <Icon name="arrow" size={14} /></a>
      </div>
    </div>
    <div class="md:col-span-2 relative min-h-40 md:min-h-full border-t md:border-t-0 md:border-l border-soft overflow-hidden grad-mesh">
      {cover
        ? <img src={cover} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        : <div class="absolute inset-0 grid place-items-center text-6xl font-display accent opacity-30">{title[0]}</div>}
    </div>
  </div>
</BentoCard>
