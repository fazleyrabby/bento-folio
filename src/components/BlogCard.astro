---
import Icon from './Icon.astro';
interface Post {
  slug: string;
  title: string;
  description?: string;
  cover?: string;
  date: Date;
  readingTime?: string;
  category?: string;
}
interface Props { post: Post; span?: string; compact?: boolean; }
const { post, span = 'col-span-12 md:col-span-6 lg:col-span-4', compact = false } = Astro.props;
const dt = new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<a href={`/post/${post.slug}`} class:list={['card card-glow group flex flex-col', span]}>
  <span class="card-glow" aria-hidden="true"></span>
  {!compact && post.cover && (
    <div class="relative aspect-[16/9] overflow-hidden border-b border-soft">
      <img src={post.cover} alt={post.title} loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
    </div>
  )}
  <div class="p-4 flex-1 flex flex-col">
    <div class="flex items-center gap-2 text-[11px] uppercase tracking-wider text-dim">
      {post.category && <span>{post.category}</span>}
      {post.category && <span class="opacity-40">·</span>}
      <span>{dt}</span>
      {post.readingTime && <><span class="opacity-40">·</span><span class="inline-flex items-center gap-1"><Icon name="clock" size={11} />{post.readingTime}</span></>}
    </div>
    <h3 class="mt-2 font-display text-base md:text-lg font-medium leading-snug group-hover:accent transition-colors">{post.title}</h3>
    {post.description && !compact && <p class="mt-1 text-sm text-muted line-clamp-2">{post.description}</p>}
  </div>
</a>
