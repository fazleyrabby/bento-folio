---
import BentoCard from './BentoCard.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<BentoCard span="col-span-12 md:col-span-6 lg:col-span-4" label="Current Focus">
  <div class="space-y-4">
    <div>
      <div class="text-xs text-dim uppercase tracking-wider mb-1.5 inline-flex items-center gap-1.5"><span class="float-y inline-flex accent"><Icon name="spark" size={12} /></span> Building</div>
      <div class="flex flex-wrap gap-1.5">
        {site.focus.building.map(b => <span class="pill !bg-[color:var(--color-accent)]/10 !text-[color:var(--color-accent)] !border-[color:var(--color-accent)]/30"><span class="dot !w-1.5 !h-1.5 !bg-[color:var(--color-accent)] tile-pulse"></span>{b}</span>)}
      </div>
    </div>
    <div>
      <div class="text-xs text-dim uppercase tracking-wider mb-1.5 inline-flex items-center gap-1.5"><Icon name="book" size={12} /> Learning</div>
      <div class="flex flex-wrap gap-1.5">
        {site.focus.learning.map(b => <span class="pill">{b}</span>)}
      </div>
    </div>
  </div>
</BentoCard>
