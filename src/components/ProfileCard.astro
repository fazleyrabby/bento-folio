---
import BentoCard from './BentoCard.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
const initials = site.name.split(' ').map(p => p[0]).slice(0, 2).join('');
---
<BentoCard span="col-span-12 lg:col-span-5" variant="mesh" padded={false}>
  <div class="p-5 h-full flex flex-col">
    <div class="flex items-center gap-3">
      <div class="relative shrink-0">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[color:var(--color-accent)] to-[color:var(--color-accent-2)] grid place-items-center text-black font-semibold">{initials}</div>
        <span class="absolute -bottom-0.5 -right-0.5 dot ring-2 ring-[color:var(--color-surface)]"></span>
      </div>
      <div class="min-w-0">
        <div class="text-[11px] text-dim uppercase tracking-wider">{site.location}</div>
        <div class="text-xs text-muted inline-flex items-center gap-1.5"><span class="dot !w-1.5 !h-1.5 !shadow-none"></span>{site.available ? 'Available for work' : 'Booked'}</div>
      </div>
    </div>

    <h1 class="mt-4 font-display text-2xl md:text-3xl font-medium tracking-tight leading-tight">{site.name}</h1>
    <p class="mt-0.5 text-[color:var(--color-accent)] text-sm font-medium">{site.role}</p>

    <p class="mt-3 text-sm text-muted leading-relaxed">{site.longBio}</p>

    <div class="mt-4 flex flex-wrap items-center gap-1.5">
      <a href={site.social.github} aria-label="GitHub" class="grid place-items-center w-8 h-8 rounded-lg bg-surface-2 border border-soft hover:border-[color:var(--color-accent)] hover:accent transition-colors"><Icon name="github" size={14} /></a>
      <a href={site.social.linkedin} aria-label="LinkedIn" class="grid place-items-center w-8 h-8 rounded-lg bg-surface-2 border border-soft hover:border-[color:var(--color-accent)] hover:accent transition-colors"><Icon name="linkedin" size={14} /></a>
      <a href={site.social.x} aria-label="X" class="grid place-items-center w-8 h-8 rounded-lg bg-surface-2 border border-soft hover:border-[color:var(--color-accent)] hover:accent transition-colors"><Icon name="x" size={14} /></a>
      <a href={`mailto:${site.email}`} aria-label="Email" class="grid place-items-center w-8 h-8 rounded-lg bg-surface-2 border border-soft hover:border-[color:var(--color-accent)] hover:accent transition-colors"><Icon name="mail" size={14} /></a>
      <a href={url('/resume')} class="ml-auto inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[color:var(--color-accent)] text-white text-xs font-medium hover:opacity-90 transition-opacity">Resume <Icon name="arrow" size={12} /></a>
    </div>
  </div>
</BentoCard>
