---
import BentoCard from './BentoCard.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
const cells = Array.from({ length: 7 * 14 }, (_, i) => {
  const seed = Math.sin(i * 9.301) * 43758.5453;
  const v = seed - Math.floor(seed);
  return v < 0.25 ? 0 : v < 0.5 ? 1 : v < 0.78 ? 2 : v < 0.93 ? 3 : 4;
});
const shades = [
  'color-mix(in oklab, var(--color-fg) 6%, transparent)',
  'color-mix(in oklab, var(--color-accent) 22%, var(--color-surface-2))',
  'color-mix(in oklab, var(--color-accent) 45%, var(--color-surface-2))',
  'color-mix(in oklab, var(--color-accent) 70%, var(--color-surface-2))',
  'var(--color-accent)',
];
---
<BentoCard span="col-span-12 md:col-span-6 lg:col-span-4" href={site.social.github} label="GitHub">
  <div class="flex items-baseline justify-between">
    <div>
      <div class="font-display text-2xl font-bold tracking-tight"><span data-counter={site.github.contributions}>0</span></div>
      <div class="text-[11px] text-dim uppercase tracking-wider">contributions / yr</div>
    </div>
    <div class="text-right text-xs text-dim space-y-0.5">
      <div class="inline-flex items-center gap-1"><Icon name="star" size={11} class="accent" /><span class="text-fg font-medium">{site.github.stars}</span> stars</div>
      <div><span class="text-fg font-medium">{site.github.repos}</span> repos</div>
    </div>
  </div>
  <div class="mt-3 grid grid-flow-col grid-rows-7 gap-[3px]">
    {cells.map((c, i) => (
      <span
        class:list={["w-2.5 h-2.5 rounded-[3px] transition-transform", c === 4 && 'tile-pulse']}
        style={`background:${shades[c]}; animation-delay:${(i % 14) * 80}ms`}
      ></span>
    ))}
  </div>
</BentoCard>
