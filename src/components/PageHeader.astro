---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---
<header class="mb-6 md:mb-8 flex flex-col gap-2">
  {eyebrow && <span class="pill self-start">{eyebrow}</span>}
  <h1 class="font-display text-3xl md:text-5xl font-medium tracking-tight">{title}</h1>
  {description && <p class="text-muted max-w-2xl">{description}</p>}
</header>
